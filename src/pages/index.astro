---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import TechnologyCard from '../components/TechnologyCard.astro';
import { reports, technologies } from '../lib/content';

const latest = reports[0];
const sourceCount = new Set(technologies.flatMap((technology) => technology.sources.map((source) => source.url))).size;
---
<BaseLayout pageType="首页">
  <section class="hero wrap">
    <div class="hero-topline"><span class="eyebrow"><span class="status-dot"></span> OPEN RESEARCH INTELLIGENCE</span><span class="mono">算法 × 生命 × 新可能</span></div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 data-pagefind-meta="title">AI <em>×</em> Bio<span class="hero-period">.</span></h1>
        <h2>在算法与生命之间，<br />发现值得追踪的进展。</h2>
        <p>连接人工智能与生命科学的一手研究。<br class="desktop-break" />从每日信号到技术脉络，让每条线索都有出处。</p>
        <div class="hero-actions"><a class="button button-dark" href="/daily/">阅读每日简报 <span aria-hidden="true">↗</span></a><a class="hero-secondary" href="/technology/">探索技术树 <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <span class="visual-label mono">THE INTERSECTION OF POSSIBILITIES</span>
        <svg class="molecule" viewBox="0 0 460 360" fill="none">
          <defs><pattern id="dots" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="currentColor" opacity=".16" /></pattern></defs>
          <rect width="460" height="360" fill="url(#dots)" />
          <ellipse cx="235" cy="181" rx="161" ry="77" transform="rotate(-36 235 181)" stroke="currentColor" opacity=".15" />
          <ellipse cx="235" cy="181" rx="161" ry="77" transform="rotate(36 235 181)" stroke="currentColor" opacity=".15" />
          <circle cx="235" cy="181" r="130" stroke="currentColor" stroke-dasharray="3 7" opacity=".16" />
          <path d="m93 238 70-102 93 34 80-88M163 136l8 127 85-93 95 86M171 263l-78-25M256 170l80-88M256 170l95 86" stroke="currentColor" stroke-width="1.5" />
          <path d="m163 136 93 34-85 93-8-127Z" fill="currentColor" opacity=".06" />
          <circle cx="93" cy="238" r="10" fill="#123c32" /><circle cx="163" cy="136" r="21" fill="#ddf885" stroke="#123c32" /><circle cx="256" cy="170" r="34" fill="#123c32" />
          <circle cx="336" cy="82" r="12" fill="#f4f3eb" stroke="#123c32" stroke-width="2" /><circle cx="171" cy="263" r="16" fill="#f4f3eb" stroke="#123c32" stroke-width="2" /><circle cx="351" cy="256" r="22" fill="#ddf885" stroke="#123c32" />
          <path d="m245 170 8 8 15-16" stroke="#ddf885" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M156 136h14M163 129v14M344 256h14M351 249v14" stroke="#123c32" stroke-width="1.5" />
          <text x="190" y="118" fill="currentColor" font-size="10" font-family="monospace">BIOLOGY</text><text x="280" y="213" fill="currentColor" font-size="10" font-family="monospace">INTELLIGENCE</text>
          <path d="M33 24h20M33 24v20M427 336h-20M427 336v-20" stroke="currentColor" opacity=".5" />
        </svg>
        <div class="visual-bottom"><span class="mono">SOURCE → STRUCTURE → INSIGHT</span><span class="visual-cross">＋</span></div>
      </div>
    </div>
    <div class="hero-stats">
      <div><strong class="mono">{String(reports.length).padStart(2, '0')}</strong><span>已发布简报</span></div>
      <div><strong class="mono">{String(technologies.length).padStart(2, '0')}</strong><span>技术知识条目</span></div>
      <div><strong class="mono">03</strong><span>技术导航层级</span></div>
      <div><strong class="mono">{String(sourceCount).padStart(2, '0')}</strong><span>知识库核验来源</span></div>
      <p class="stats-note">每一条进展，<br />都从可靠来源开始。</p>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="latest-title">
    <div class="section-heading"><div><p class="eyebrow"><span class="section-number">01</span> DAILY SIGNALS</p><h2 id="latest-title">每日的线索<span class="heading-dot">.</span></h2></div><a class="text-link" href="/daily/">全部简报 <span aria-hidden="true">↗</span></a></div>
    {latest ? (
      <div class="latest-report">
        <div class="report-date-block"><p class="eyebrow">LATEST VERIFIED REPORT</p><time datetime={latest.date} class="mono">{latest.date}</time><span class="verified-badge">来源已核验</span></div>
        <div><h3><a href={`/daily/${latest.date}/`}>{latest.title}</a></h3><p>{latest.summary}</p><ul class="latest-headlines">{latest.articles.map((article) => <li><a href={`/daily/${latest.date}/#${article.id}`}>{article.title}<span aria-hidden="true">↗</span></a></li>)}</ul></div>
      </div>
    ) : (
      <EmptyState eyebrow="AWAITING THE FIRST VERIFIED REPORT" title="第一期简报，等待可信的信号。" description="目前尚无已发布的每日简报。历史消息需完成来源与日期核验后才会归档；你可以先探索已核验的基础技术知识。" href="/technology/" linkLabel="从技术树开始" />
    )}
  </section>

  <section class="knowledge-section" aria-labelledby="knowledge-title">
    <div class="wrap">
      <div class="section-heading"><div><p class="eyebrow"><span class="section-number">02</span> CONNECT THE KNOWLEDGE</p><h2 id="knowledge-title">新闻会过去，知识会生长<span class="heading-dot">.</span></h2><p class="section-intro">先理解方法，再判断进展。沿着领域、路线与核心技术，找到研究的坐标。</p></div><a class="text-link" href="/technology/">浏览技术树 <span aria-hidden="true">↗</span></a></div>
      <div class="technology-grid">{technologies.slice(0, 3).map((technology, index) => <TechnologyCard technology={technology} index={index} />)}</div>
    </div>
  </section>

  <section class="principles wrap">
    <p class="eyebrow">OUR EDITORIAL PRINCIPLES</p>
    <h2>好线索，经得起追问。</h2>
    <div class="principle-grid"><div><span class="mono">↗ 01 / 可追溯</span><p>优先论文与官方来源，保留原始链接及核验日期。</p></div><div><span class="mono">↗ 02 / 有边界</span><p>区分模型能力与适用限制，让判断保留必要的上下文。</p></div><div><span class="mono">↗ 03 / 可连接</span><p>让每日进展回到技术脉络，积累可检索的开放档案。</p></div></div>
  </section>
</BaseLayout>
