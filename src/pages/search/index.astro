---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
---
<BaseLayout title="全站搜索 · AI × Bio" pageType="搜索" noIndex>
  <div class="wrap search-page" data-pagefind-ignore="all">
    <PageHeading number="04" english="FOLLOW YOUR CURIOSITY" title="从一个问题开始" description="搜索技术原理、论文来源、每日进展与机会线索。在不同的知识节点之间，找到你的路径。" />
    <div id="search" aria-label="全站全文搜索"></div>
    <p id="search-status" class="search-status" role="status">正在准备站内索引…</p>
    <noscript><p class="editorial-note">全文搜索需要启用 JavaScript。你也可以直接浏览<a href="/technology/">技术树</a>或<a href="/daily/">每日简报</a>。</p></noscript>
    <div class="search-hints"><span class="eyebrow">TRY A THREAD</span><div><a href="?q=AlphaFold">AlphaFold ↗</a><a href="?q=蛋白质">蛋白质 ↗</a><a href="?q=单细胞">单细胞 ↗</a><a href="?q=扩散">扩散 ↗</a></div><p>搜索覆盖已发布的站内内容；基础知识条目与每日简报可通过类型筛选区分。</p></div>
  </div>
  <script is:inline>
    // Load the generated index in production and retain a useful fallback in development.
    const searchStatus = document.getElementById('search-status');
    const stylesheet = document.createElement('link');
    stylesheet.rel = 'stylesheet';
    stylesheet.href = '/pagefind/pagefind-ui.css';
    document.head.appendChild(stylesheet);
    const loader = document.createElement('script');
    loader.src = '/pagefind/pagefind-ui.js';
    loader.onload = () => {
      if (!window.PagefindUI) return;
      const ui = new window.PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false, translations: { placeholder: '搜索技术、论文、研究进展…', zero_results: '没有找到 “[SEARCH_TERM]” 的相关内容', clear_search: '清除', load_more: '更多结果', search_label: '搜索本站', filters_label: '筛选', searching: '正在搜索…' } });
      searchStatus.hidden = true;
      const query = new URLSearchParams(window.location.search).get('q');
      if (query) ui.triggerSearch(query);
    };
    loader.onerror = () => {
      searchStatus.innerHTML = '全文索引会在网站构建后生成。本地开发时请先构建并预览；你也可以直接浏览<a href="/technology/">技术树</a>。';
    };
    document.body.appendChild(loader);
  </script>
</BaseLayout>
