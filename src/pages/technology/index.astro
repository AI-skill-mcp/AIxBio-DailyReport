---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import TaxonomyBranch from '../../components/TaxonomyBranch.astro';
import TechnologyCard from '../../components/TechnologyCard.astro';
import { technologies } from '../../lib/content';
import { navigationNodeCount } from '../../lib/technology-tree';
---
<BaseLayout title="技术树 · AI × Bio" pageType="技术树">
  <div class="wrap">
    <PageHeading number="02" english="THE KNOWLEDGE TREE" title="把进展放回技术脉络" description="按领域、技术路线、核心技术三层浏览。每类说明关键区别，并关联已收录的模型、平台与评测方法，让相近技术的边界更清楚。" />
    <div class="tree-layout">
      <aside class="tree-guide"><span class="eyebrow">HOW TO EXPLORE</span><h2>一棵持续生长的技术树。</h2><p>领域与路线可展开；第三层说明核心技术的区分特点，并提供已收录条目的详情链接。节点右侧数字表示知识条目数。</p><div class="tree-guide-stats"><strong class="mono">{navigationNodeCount}</strong><span>导航节点</span><strong class="mono">{technologies.length}</strong><span>技术知识条目</span></div><p class="small muted">分类为本项目的导航框架，不代表领域唯一或完整的分类标准。</p><div class="tree-index-links"><a class="text-link" href="https://github.com/AI-skill-mcp/AIxBio-DailyReport/blob/main/indexes/technology-navigation.md" target="_blank" rel="noopener noreferrer">分类索引 · Markdown ↗</a><a class="text-link" href="https://github.com/AI-skill-mcp/AIxBio-DailyReport/blob/main/indexes/technology-navigation.json" target="_blank" rel="noopener noreferrer">分类索引 · JSON ↗</a></div></aside>
      <section class="taxonomy-tree" aria-label="三层技术分类"><div class="tree-toolbar"><span class="mono">领域 → 路线 → 核心技术</span><span>点击 ＋ 展开</span></div><TaxonomyBranch /></section>
    </div>
    <section class="section" aria-labelledby="technologies-title"><div class="section-heading"><div><p class="eyebrow">FOUNDATIONAL KNOWLEDGE</p><h2 id="technologies-title">从这里，深入一层<span class="heading-dot">.</span></h2></div><span class="mono muted">{technologies.length} ENTRIES</span></div><div class="technology-grid">{technologies.map((technology, index) => <TechnologyCard technology={technology} index={index} />)}</div></section>
  </div>
</BaseLayout>
