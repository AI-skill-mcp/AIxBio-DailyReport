---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import EmptyState from '../../components/EmptyState.astro';
import { opportunities, technologies } from '../../lib/content';
const kindNames = { research: '科研探索', product: '产品方向', startup: '创业线索' };
---
<BaseLayout title="机会雷达 · AI × Bio" pageType="机会雷达">
  <div class="wrap">
    <PageHeading number="03" english="OPPORTUNITY RADAR" title="从进展，到下一步" description="把已核验的研究进展转化为可追问的问题、可探索的方向。每条机会都连接原始简报，并保留具体的下一步。" />
    <div class="listing-meta"><span class="mono">{String(opportunities.length).padStart(2, '0')} OPPORTUNITIES</span><span>机会为研究线索，需结合实际场景进一步验证</span></div>
    {opportunities.length ? <div class="opportunity-grid">{opportunities.map((opportunity) => <article class="opportunity-card" id={opportunity.id}><div class="card-meta"><span class="tag">{kindNames[opportunity.kind]}</span><time class="mono" datetime={opportunity.reportDate}>{opportunity.reportDate}</time></div><h2>{opportunity.title}</h2><p>{opportunity.description}</p><div class="next-step"><span class="eyebrow">NEXT STEP / 下一步</span><p>{opportunity.next_step}</p></div><div class="tag-list">{opportunity.technology_ids.map((id) => <a href={`/technology/${id}/`}>{technologies.find((technology) => technology.id === id)?.name ?? id}</a>)}</div><a class="text-link" href={`/daily/${opportunity.reportDate}/#${opportunity.articleId}`}>查看原始进展 <span aria-hidden="true">↗</span></a></article>)}</div> : <EmptyState eyebrow="EVIDENCE BEFORE OPPORTUNITY" title="等待有依据的下一步。" description="目前没有来自已发布简报的机会条目。机会雷达会在相关进展完成核验后，提炼科研、产品与创业线索。" href="/technology/" linkLabel="先理解基础技术" />}
  </div>
</BaseLayout>
