---
interface Props {
  number: string;
  english: string;
  title: string;
  description: string;
}
const { number, english, title, description } = Astro.props;
---
<header class="page-heading">
  <div class="eyebrow"><span class="section-number">{number}</span> {english}</div>
  <h1 data-pagefind-meta="title">{title}<span class="heading-dot">.</span></h1>
  <p>{description}</p>
  <slot />
</header>
