{
  "name": "aixbio-daily-report",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "generate": "node scripts/generate.mjs",
    "validate": "node scripts/validate.mjs && node scripts/generate.mjs --check",
    "check": "pnpm validate && astro check",
    "test": "node --test scripts/*.test.mjs",
    "build": "pnpm validate && astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "astro": "7.4.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@pagefind/default-ui": "1.5.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "pagefind": "1.5.2",
    "typescript": "5.9.3"
  }
}
