{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bioinformatic.tech/schemas/technology-navigation.schema.json",
  "title": "Three-level technology navigation",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "domains"],
  "properties": {
    "version": { "const": "1.0" },
    "updated_at": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "domains": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/domain" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["technology_id", "role"],
      "properties": {
        "technology_id": { "$ref": "#/definitions/id" },
        "role": { "$ref": "#/definitions/text" }
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description", "research_object", "primary_output", "discriminator", "boundary", "members"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "research_object": { "$ref": "#/definitions/text" },
        "primary_output": { "$ref": "#/definitions/text" },
        "discriminator": { "$ref": "#/definitions/text" },
        "boundary": { "$ref": "#/definitions/text" },
        "members": { "type": "array", "items": { "$ref": "#/definitions/member" } }
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "english_name", "description", "entries"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "$ref": "#/definitions/text" },
        "english_name": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/entry" } }
      }
    },
    "domain": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "english_name", "description", "routes"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "$ref": "#/definitions/text" },
        "english_name": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "routes": { "type": "array", "items": { "$ref": "#/definitions/route" } }
      }
    }
  }
}
