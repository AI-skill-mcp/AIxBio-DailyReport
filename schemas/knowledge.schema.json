{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bioinformatic.tech/schemas/knowledge.schema.json",
  "definitions": {
    "taxonomy": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "english_name", "parent_id", "level"],
        "properties": {
          "id": { "$ref": "daily-report.schema.json#/definitions/id" },
          "name": { "$ref": "daily-report.schema.json#/definitions/text" },
          "english_name": { "$ref": "daily-report.schema.json#/definitions/text" },
          "parent_id": { "anyOf": [{ "type": "null" }, { "$ref": "daily-report.schema.json#/definitions/id" }] },
          "level": { "type": "integer", "minimum": 1, "maximum": 6 }
        }
      }
    },
    "organizations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "english_name", "url"],
        "properties": {
          "id": { "$ref": "daily-report.schema.json#/definitions/id" },
          "name": { "$ref": "daily-report.schema.json#/definitions/text" },
          "english_name": { "$ref": "daily-report.schema.json#/definitions/text" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "target_id", "kind"],
        "properties": {
          "source_id": { "$ref": "daily-report.schema.json#/definitions/id" },
          "target_id": { "$ref": "daily-report.schema.json#/definitions/id" },
          "kind": { "enum": ["builds-on", "complements", "alternative-to"] }
        }
      }
    }
  }
}
