{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bioinformatic.tech/schemas/technology.schema.json",
  "title": "Verified foundational technology",
  "type": "object", "additionalProperties": false,
  "required": ["id", "name", "english_name", "summary", "description", "method", "limitations", "technology_path", "sources", "related_ids"],
  "properties": {
    "id": { "$ref": "daily-report.schema.json#/definitions/id" },
    "name": { "$ref": "daily-report.schema.json#/definitions/text" },
    "english_name": { "$ref": "daily-report.schema.json#/definitions/text" },
    "summary": { "$ref": "daily-report.schema.json#/definitions/text" },
    "description": { "$ref": "daily-report.schema.json#/definitions/text" },
    "method": { "$ref": "daily-report.schema.json#/definitions/text" },
    "limitations": { "$ref": "daily-report.schema.json#/definitions/text" },
    "technology_path": { "$ref": "daily-report.schema.json#/definitions/path" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "daily-report.schema.json#/definitions/source" } },
    "related_ids": { "$ref": "daily-report.schema.json#/definitions/ids" }
  }
}
